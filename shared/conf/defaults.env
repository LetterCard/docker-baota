# ==============================================================================
#  ⚙️ 运行期配置真源（构建期复制到 /baota/defaults.env）
#
#  解决的问题：PERSIST_DIRS 这类常量原本在 Dockerfile ENV、init-mounts.sh、
#  entrypoint.sh、CI 的检查脚本等多处各写一份，改一处漏一处就会静默出错。
#  现在运行期的四份脚本（init-mounts / entrypoint / backup / healthcheck）
#  都从这里取值，CI 的 health-check/ 三套检查脚本也从本文件解析，做到单一真源。
#
#  ★ 写法约定：一律 ${VAR:-默认值}
#    保证「已存在的环境变量优先」——Dockerfile 的 ENV 与用户在 compose 里
#    传的值不会被这里覆盖。本文件只做兜底，不做覆盖。
#
#  ⚠️ 本文件由 busybox sh（init-mounts.sh）与 bash（其余）共同 source，
#    只能用 POSIX 语法：不要用 local / [[ ]] / 数组 / 进程替换。
# ==============================================================================

# 持久化根：容器内挂载点。默认 ./data:/data 单卷即可。
PERSIST_DATA_ROOT="${PERSIST_DATA_ROOT:-/data}"

# 目录模型（宿主机 data/ 下，与容器内一一对应）：
#
#   data/www/            业务数据（直通，宿主机可直接 SMB/文件管理读写）
#     ├─ wwwroot/        站点     ↔ 容器 /www/wwwroot
#     ├─ backup/         备份     ↔ 容器 /www/backup
#     └─ server/data/    MySQL    ↔ 容器 /www/server/data
#   data/system/         系统层
#     ├─ panel/          /www 面板 overlay upper（server/panel、wwwlogs 等增量）
#     ├─ etc/ usr/ var/ root/ opt/ home/ srv/   各目录 overlay upper
#     └─ .baota/         项目元数据（锁、版本记录、启动历史）
#   data/.baota/         数据层状态（工作目录，隐藏）
#
# 说明：/www 在容器里仍是「镜像面板 lower + upper」的 overlay（面板代码随镜像
# 升级），它的 upper 落在 data/system/panel；业务三目录是 overlay 之后的 bind
# 直通，源在 data/www 下（不在任何 upper 里），宿主机直改有内核保证。
PERSIST_SYSTEM_ROOT="${PERSIST_SYSTEM_ROOT:-/data/system}"

# /www 面板 overlay 的 upper 目录。放系统层下便于宿主感知（平时不用翻）
PANEL_UPPER_DIR="${PANEL_UPPER_DIR:-${PERSIST_SYSTEM_ROOT}/panel}"

# 直通（bind，绕过 overlay）的业务目录。源统一在「数据层根/www<去掉 /www 后的路径>」，
# 即：/www/wwwroot -> /data/www/wwwroot、/www/backup -> /data/www/backup、
#     /www/server/data -> /data/www/server/data。
# 置空可整体关闭直通（此时回落到 /www overlay upper，即 data/system/panel 下）
PASSTHROUGH_DIRS="${PASSTHROUGH_DIRS:-/www/wwwroot /www/backup /www/server/data}"

# 数据层要 overlay 持久化的顶层目录。与 PERSIST_SYSTEM_DIRS 对称：
# 这一层走 overlay（lower 随镜像升级），upper 由 PANEL_UPPER_DIR 指定，
# 落在系统层下（data/system/panel）；真正的业务数据不走 overlay，
# 走上面的 PASSTHROUGH_DIRS 直通。
#
# ⚠️ 本变量曾长期只存在于 entrypoint.sh 与 services.sh 各自的兜底里，
#    真源文件里漏了 —— 与文档（docs/configuration.md）和 skill 里
#    「唯一真源是 defaults.env」的说法不符。补在这里，三处共用一份。
PERSIST_DATA_DIRS="${PERSIST_DATA_DIRS:-www}"

# 系统层要 overlay 持久化的顶层目录。
# 实测（全新安装后统计条目数）：etc 856 / usr 26750 / var 1768 /
# root 1759（www 属数据层，见 PERSIST_DATA_DIRS，实测 31623）；
# opt、home、srv 为 0 但不可移除 ——
#   opt  堡塔 RASP 应用防护会写 /opt/rasp*/logs
#   home 面板会 os.makedirs("/home/www")
#   srv  仅出现在面板的「危险目录黑名单」，非落点，但保留成本为零
# 移除其中任何一个都要先确认上游不再写入，否则是静默丢数据
PERSIST_SYSTEM_DIRS="${PERSIST_SYSTEM_DIRS:-etc usr var root opt home srv}"

# 关键目录：持久化失败即静默丢数据，必须在容器状态里直接可见。
# init-mounts.sh 对失败的目录逐个比对本列表，命中就写
# /run/baota/degraded-critical，healthcheck 据此判 unhealthy。
#
# ★ 列表里的名字必须是「循环里传进 mount_persist 的那个顶层目录名」，
#   即 www 或 PERSIST_SYSTEM_DIRS 里的某一个，不是 upper 目录名。
#   这里曾写成 panel（upper 目录名），而循环传的是 www —— 两者永远对不上，
#   面板层持久化失败时只写普通 degraded、不写 degraded-critical，
#   healthcheck 判 healthy，面板与证书的数据就这样静默丢了。
# www = 面板 / 证书那层（upper 在 data/system/panel），etc / var 见上
CRITICAL_DIRS="${CRITICAL_DIRS:-etc var www}"

# 健康检查的磁盘水位阈值（/baota/healthcheck.sh 每 30 秒现查一次）。
#   任一持久化根「可用 < DISK_MIN_AVAIL_MB」或「已用 ≥ DISK_MAX_USED_PCT」
#   即判 unhealthy —— 满盘时 InnoDB 会写坏、面板配置会失败，必须在崩溃前暴露。
# 大盘（几 TB 存储池）上 1GB 的告警线偏低时可调大，例如 10240（10GB）
DISK_MIN_AVAIL_MB="${DISK_MIN_AVAIL_MB:-1024}"
DISK_MAX_USED_PCT="${DISK_MAX_USED_PCT:-95}"

# 升级 / 降级前自动快照的保留份数。0 表示关闭快照
AUTO_BACKUP_KEEP="${AUTO_BACKUP_KEEP:-3}"
