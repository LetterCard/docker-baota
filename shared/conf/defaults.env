# ==============================================================================
#  ⚙️ 运行期配置真源（构建期复制到 /baota/defaults.env）
#
#  解决的问题：PERSIST_DIRS 这类常量原本在 Dockerfile ENV、init-mounts.sh、
#  entrypoint.sh、CI 的检查脚本等多处各写一份，改一处漏一处就会静默出错。
#  现在运行期的四份脚本（init-mounts / entrypoint / backup / healthcheck）
#  都从这里取值，CI 的 health-check/ 三套检查脚本也从本文件解析，做到单一真源。
#
#  ★ 写法约定：一律 ${VAR:-默认值}
#    保证「已存在的环境变量优先」——Dockerfile 的 ENV 与用户在 compose 里
#    传的值不会被这里覆盖。本文件只做兜底，不做覆盖。
#
#  ⚠️ 本文件由 busybox sh（init-mounts.sh）与 bash（其余）共同 source，
#    只能用 POSIX 语法：不要用 local / [[ ]] / 数组 / 进程替换。
# ==============================================================================

# 持久化根目录（容器内挂载点），按职责拆成「数据层」与「系统层」：
#   PERSIST_DATA_ROOT   数据层：面板 / 站点 / 数据库 / 备份 —— 用户唯一需要关心的
#   PERSIST_SYSTEM_ROOT 系统层：etc/usr/var/root/opt/home/srv 的 overlay 上层
#
# ★ 布局模型（与容器内路径一一对应，没有多余层级）：
#   每个顶层目录各挂一层 overlay：upper 落在「数据层根/成员名」或「系统层根/成员名」。
#   数据层唯一的成员是 www，于是：
#     /www  ←overlay→  upper = /data/www
#   宿主机 data/www/ 就是容器 /www 的持久化层 —— server/panel、wwwroot、backup、
#   wwwlogs 都在它下面（data/www/wwwroot 就是站点，与官方路径一致）。
#   系统层成员名（etc/usr/var…）与根名 system 不冲突，落在 /data/system/<成员名>。
#
#   注意这是 overlay 的「增量层」：data/www/ 只存你新建或改过的文件，
#   镜像自带的文件在 lower（换镜像即更新），不会整份出现在 data/www 里。
#   站点、备份、MySQL 数据都是运行期新建的，所以在 data/www 下是完整的一份。
#
#  compose 只挂一个 data 目录（./data:/data）即可，两种层的路径见 docs/configuration.md
PERSIST_DATA_ROOT="${PERSIST_DATA_ROOT:-/data}"
PERSIST_SYSTEM_ROOT="${PERSIST_SYSTEM_ROOT:-/data/system}"

# 数据层要 overlay 持久化的顶层目录（目前只有 www —— 容器 /www 的整层持久化）
PERSIST_DATA_DIRS="${PERSIST_DATA_DIRS:-www}"
# 系统层要 overlay 持久化的顶层目录。
# 实测（全新安装后统计条目数）：etc 856 / usr 26750 / var 1768 /
# www 31623 / root 1759；opt、home、srv 为 0 但不可移除 ——
#   opt  堡塔 RASP 应用防护会写 /opt/rasp*/logs
#   home 面板会 os.makedirs("/home/www")
#   srv  仅出现在面板的「危险目录黑名单」，非落点，但保留成本为零
# 移除其中任何一个都要先确认上游不再写入，否则是静默丢数据
PERSIST_SYSTEM_DIRS="${PERSIST_SYSTEM_DIRS:-etc usr var root opt home srv}"

# 关键目录：它们一旦持久化失败就会静默丢数据，必须在容器状态里直接可见。
# init-mounts.sh 对失败的目录逐个比对本列表，命中就写
# /run/baota/degraded-critical，healthcheck 据此判 unhealthy。
# 注意：www 在数据层、其它在系统层，但都属于 CRITICAL_DIRS 的判定范围
CRITICAL_DIRS="${CRITICAL_DIRS:-etc var www}"

# 健康检查的磁盘水位阈值（/baota/healthcheck.sh 每 30 秒现查一次）。
#   数据层或系统层任一「可用 < DISK_MIN_AVAIL_MB」或「已用 ≥ DISK_MAX_USED_PCT」
#   即判 unhealthy —— 满盘时 InnoDB 会写坏、面板配置会失败，必须在崩溃前暴露。
# 大盘（几 TB 存储池）上 1GB 的告警线偏低时可调大，例如 10240（10GB）
DISK_MIN_AVAIL_MB="${DISK_MIN_AVAIL_MB:-1024}"
DISK_MAX_USED_PCT="${DISK_MAX_USED_PCT:-95}"

# 升级 / 降级前自动快照的保留份数。0 表示关闭快照
AUTO_BACKUP_KEEP="${AUTO_BACKUP_KEEP:-3}"
