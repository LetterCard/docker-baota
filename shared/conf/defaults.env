# ==============================================================================
#  ⚙️ 运行期配置真源（构建期复制到 /baota/defaults.env）
#
#  解决的问题：PERSIST_DIRS 这类常量原本在 Dockerfile ENV、init.sh、
#  entrypoint.sh、CI 的检查脚本等多处各写一份，改一处漏一处就会静默出错。
#  现在运行期的四份脚本（init.sh / entrypoint / backup / healthcheck）
#  都从这里取值，CI 的 check/ 三套检查脚本也从本文件解析，做到单一真源。
#
#  ★ 写法约定：一律 ${VAR:-默认值}
#    保证「已存在的环境变量优先」——Dockerfile 的 ENV 与用户在 compose 里
#    传的值不会被这里覆盖。本文件只做兜底，不做覆盖。
#
#  ⚠️ 本文件由 busybox sh（init.sh）与 bash（其余）共同 source，
#    只能用 POSIX 语法：不要用 local / [[ ]] / 数组 / 进程替换。
# ==============================================================================

# 持久化根：容器内挂载点。默认 ./data:/data 单卷即可。
PERSIST_DATA_ROOT="${PERSIST_DATA_ROOT:-/data}"

# 目录模型（宿主机 data/ 下，与容器内一一对应）：
#
#   data/www/            业务数据（bind 直通，宿主机可直接 SMB/文件管理读写）
#     ├─ wwwroot/        站点     ↔ 容器 /www/wwwroot
#     ├─ backup/         备份     ↔ 容器 /www/backup
#     └─ server/data/    MySQL    ↔ 容器 /www/server/data
#   data/panel/    面板状态（bind 直通，面板代码本身不持久化）
#     ├─ data/           面板配置 / SQLite ↔ /www/server/panel/data
#     └─ plugin/         插件             ↔ /www/server/panel/plugin
#   data/system/         系统层（overlay upper）
#     ├─ etc/ usr/ var/ root/ opt/ home/ srv/   各目录 overlay upper
#     └─ .baota/         项目元数据（锁、版本记录、启动历史）
#   data/.baota/         数据层状态（工作目录，隐藏）
#
# ★ 不可变面板：/www/server/panel 的代码不进持久化层，直接来自镜像层。
#   升级面板 = 换镜像：面板内「更新」的写入落在容器可写层，restart 不消失、
#   销毁重建后即还原为镜像版本，本项目不依赖也不拦截面板内更新
#   （不靠「禁用更新补丁」那套对抗上游的跟踪）。
PERSIST_SYSTEM_ROOT="${PERSIST_SYSTEM_ROOT:-/data/system}"

# 业务数据子目录（相对 /www）。逐个 bind 到「数据层根/www/<子目录>」。
# 宿主机直改这些目录有内核保证（它们不在任何 overlay upper 里）。
WWW_DATA_SUBDIRS="${WWW_DATA_SUBDIRS:-wwwroot backup server/data}"

# 面板「状态」子目录（相对 /www/server/panel）。
# 面板代码本身来自镜像，只有这里列出的子目录才持久化：
#   data    面板配置、SQLite 库、端口与安全入口
#   plugin  已安装的面板插件
# 需要面板内安装 pip 包（部分插件会用）时把 pyenv 也加进来：
#   PANEL_STATE_SUBDIRS: "data plugin pyenv"
# ⚠️ pyenv 一旦持久化就不再随镜像更新，一般不需要
PANEL_STATE_ROOT="${PANEL_STATE_ROOT:-${PERSIST_DATA_ROOT}/panel}"
PANEL_STATE_SUBDIRS="${PANEL_STATE_SUBDIRS:-data plugin}"

# 系统层要 overlay 持久化的顶层目录。
# 实测（全新安装后统计条目数）：etc 856 / usr 26750 / var 1768 / root 1759；
# （面板 /www 不再计入：它的代码来自镜像层，只有业务与状态子目录持久化）
# opt、home、srv 为 0 但不可移除 ——
#   opt  堡塔 RASP 应用防护会写 /opt/rasp*/logs
#   home 面板会 os.makedirs("/home/www")
#   srv  仅出现在面板的「危险目录黑名单」，非落点，但保留成本为零
# 移除其中任何一个都要先确认上游不再写入，否则是静默丢数据
PERSIST_SYSTEM_DIRS="${PERSIST_SYSTEM_DIRS:-etc usr var root opt home srv}"

# 关键目录：持久化失败即静默丢数据，必须在容器状态里直接可见。
# init.sh 对失败的挂载逐个比对本列表，命中就写
# /run/baota/degraded-critical，healthcheck 据此判 unhealthy。
#
# ★ 列表里写「容器内的挂载点路径」，与脚本传给 is_critical 的判断值一致：
#   系统层 overlay 失败传 /etc、/var…，业务与面板状态 bind 失败传 /www/xxx。
#   写成顶层目录名（如 www）会永远对不上 —— www 不再作为整体挂载，
#   它的代码来自镜像层，只有下面的子目录才是真正需要持久化的部分。
# /usr 必须在列表里：用户在容器里 apt 装的软件、面板里装的 PHP 扩展都落在
# /usr。它持久化失败而容器状态仍是绿的，就成了「绿着丢数据」—— 静默丢失、
# 且要等重建后才发现，性质与 /etc 失败一样严重
CRITICAL_DIRS="${CRITICAL_DIRS:-/etc /usr /var /www/wwwroot /www/server/data /www/server/panel/data}"

# 健康检查的磁盘水位阈值（/baota/healthcheck.sh 每 30 秒现查一次）。
#   任一持久化根「可用 < DISK_MIN_AVAIL_MB」或「已用 ≥ DISK_MAX_USED_PCT」
#   即判 unhealthy —— 满盘时 InnoDB 会写坏、面板配置会失败，必须在崩溃前暴露。
# 大盘（几 TB 存储池）上 1GB 的告警线偏低时可调大，例如 10240（10GB）
DISK_MIN_AVAIL_MB="${DISK_MIN_AVAIL_MB:-1024}"
DISK_MAX_USED_PCT="${DISK_MAX_USED_PCT:-95}"

# 升级 / 降级前自动快照的保留份数。0 表示关闭快照
AUTO_BACKUP_KEEP="${AUTO_BACKUP_KEEP:-3}"
