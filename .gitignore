# ==============================================================================
#  Git 忽略清单
#
#  注意区分：.dockerignore 管「构建上下文」，本文件管「git 提交」。
#  最关键的是 data/ —— 里面有面板配置、数据库、SSH 密钥和口令，
#  一旦提交到公开仓库等于全盘泄漏。
# ==============================================================================

# macOS
.DS_Store

# 运行期数据：容器持久化目录（含面板配置、数据库、SSH 密钥、口令）
data/

# 运行期日志
*.log

# 备份产物（tar 打出来的包，无论是在宿主机还是容器内生成的）
*.tgz

# 密钥与本地环境（口令不要写进 docker-compose.yml，改用同目录的 .env）
.env
.env.*
!.env.example

# 本地测试残留
.tmp-*

# lint 自动下载的 shellcheck 二进制（版本钉死在 lint/shellcheck.sh）
.cache/
