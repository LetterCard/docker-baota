# ==============================================================================
#  ⚙️ 运行期配置真源（构建期复制到 /baota/defaults.env）
#
#  解决的问题：PERSIST_SYSTEM_DIRS 这类常量原本在 Dockerfile ENV、init.sh、
#  entrypoint.sh、CI 的检查脚本等多处各写一份，改一处漏一处就会静默出错。
#  现在运行期的四份脚本（init.sh / entrypoint / backup / healthcheck）
#  都从这里取值，CI 的 check/ 四套检查脚本也从本文件解析，做到单一真源。
#
#  ★ 写法约定：一律 ${VAR:-默认值}
#    保证「已存在的环境变量优先」——Dockerfile 的 ENV 与用户在 compose 里
#    传的值不会被这里覆盖。本文件只做兜底，不做覆盖。
#
#  ⚠️ 本文件由 busybox sh（init.sh）与 bash（其余）共同 source，
#    只能用 POSIX 语法：不要用 local / [[ ]] / 数组 / 进程替换。
# ==============================================================================

# 持久化根：容器内挂载点。默认 ./data:/data 单卷即可。
PERSIST_DATA_ROOT="${PERSIST_DATA_ROOT:-/data}"

# 目录模型（完整树见 docs/conventions.md §3，这里只留骨架）。
# ★ 规则只有一条：data/www 下的路径 = 容器内的路径 —— 找什么按容器路径找。
#   data/www/    业务与面板状态（bind 直通）：wwwroot/ backup/ server/data/、
#                 server/panel/{data,plugin,vhost,ssl,config}/、vmail dk_project/
#   data/.system/  系统层（overlay upper，隐藏：相对镜像的增量）
#   data/.baota/   数据层元数据（并发锁，隐藏）
# ★ 不可变面板：/www/server/panel 代码不进持久化层、直接来自镜像层。
#   升级面板 = 换镜像；面板内「更新」写入落容器可写层，销毁重建即还原。
#   本项目不依赖也不拦截面板内更新（不靠「禁用更新补丁」对抗上游）。
PERSIST_SYSTEM_ROOT="${PERSIST_SYSTEM_ROOT:-${PERSIST_DATA_ROOT}/.system}"

# 持久化层元数据（.baota 目录里）的文件名。
# ★ 只用「一个单词 + 扩展名」，不写连字符组合：这些文件名是给人敲的
#   （排障时 `cat data/.system/.baota/version`），短比「信息完整」重要，
#   目录上下文（.baota）已经说明它们属于本项目。
# ★ 脚本与 CI 都从这里取值，改名不会各处漂移
META_VERSION_FILE="${META_VERSION_FILE:-version}"
META_BOOT_FILE="${META_BOOT_FILE:-boot.log}"

# 业务数据子目录（相对 /www），逐个 bind 到「数据层根/www/<子目录>」——
# 不在任何 overlay upper 里，宿主机直改有内核保证。
#   wwwroot 站点 / backup 备份 / server/data MySQL（虽在 /www/server 内，但那层
#   走 overlay，单独 bind 才能让数据库文件不进 overlay）
# 「装了才有」的模块见 WWW_OPTIONAL_SUBDIRS（不预建）。
#
# ★ 这份是「我们决定持久化什么」的决策清单，不是「跟踪上游往哪写」，所以不随
#   上游漂移：面板/插件新增数据目录时往这里加一个词就够了
# 反面清单（明确**不**持久化的）见下面的 WWW_VOLATILE_SUBDIRS
WWW_DATA_SUBDIRS="${WWW_DATA_SUBDIRS:-wwwroot backup server/data}"

# 按设计**不**持久化的 /www 子路径：站点日志 wwwlogs、回收站 .Recycle_bin
# （上游 13 的落点，旧名 Recycle_bin）、php_session、panel-static、monitor_data
# —— 它们与容器同生共死、重建即空，都是可再生的日志 / 缓存 / 暂存区。回收站里
# 没的是「后悔药」本身：面板的回收站列表由扫目录得出、不是数据库记录，不会出现
# 「有记录没文件」的错位。想连回收站一起保住，把它的目录名移进 WWW_DATA_SUBDIRS。
#
# ★ 运行期对它们**不做任何事**（没 bind 就是不持久化），这段只是「为什么不保」的说明。
#   漂移检测判「按设计不持久化」用的白名单在 .github/scripts/drift/install.sh
#   的 WWW_VOLATILE_SUBDIRS —— 只有那一处是机器读的，别在这里列第二份

# 可选模块的数据目录（相对 /www）：面板里**装了对应模块**才产生，
# 所以不预建 —— 没装就不出现，不让每个用户都在 data/www 下看到空目录。
#   vmail       邮局（邮件服务）的邮件与账号库（面板装邮局时落 /www/vmail）
#   dk_project  面板「Docker」模块的项目目录与 compose 备份（/www/dk_project）
# 语义与 WWW_DATA_SUBDIRS 一致（bind 到 data/www/<子目录>），唯一区别是
# 「不预建 + 出现后才纳入持久化」，实现见 init.sh 的 bind_optional_subdir。
# ★ 判据：装了才有的 → 这里；装好就有的 → WWW_DATA_SUBDIRS
WWW_OPTIONAL_SUBDIRS="${WWW_OPTIONAL_SUBDIRS:-vmail dk_project}"

# 面板「状态」子目录（相对 /www/server/panel，归位在业务层里）。持久化源落在
# 同名的 data/www/server/panel/<子目录>，规则与业务目录一致。面板代码来自镜像，
# 只有这里列出的子目录才持久化。清单是「我们持久化哪些状态」、不是「跟踪上游往
# 哪写」，所以不随上游漂移：
#   data 配置/SQLite 库/端口入口、plugin 插件、vhost 站点配置与证书（丢了 HTTPS 挂）、
#   ssl 面板自身证书、config 设置类文件。需装 pip 包（部分插件）时把 pyenv 加进来：
#   PANEL_STATE_SUBDIRS="data plugin vhost ssl config pyenv"
# ⚠️ pyenv 一旦持久化就不再随镜像更新，一般不需要
PANEL_STATE_ROOT="${PANEL_STATE_ROOT:-${PERSIST_DATA_ROOT}/www/server/panel}"
PANEL_STATE_SUBDIRS="${PANEL_STATE_SUBDIRS:-data plugin vhost ssl config}"

# 系统层要 overlay 持久化的目录。实测全新安装后条目数：etc 856 / usr 26750 /
# var 1768 / root 1759（面板 /www 不再计入：代码来自镜像层，只业务与状态子目录持久化）。
# opt/home/srv 为 0 但不可移除：opt 堡塔 RASP 会写 /opt/rasp*/logs；
# home 面板 os.makedirs("/home/www")；srv 仅出现在危险目录黑名单、保留成本为零。
# 移除任一个都要先确认上游不再写入，否则静默丢数据。
# www/server 是面板里装的东西（nginx/php/mysql/组件/cron/插件数据）的落点，
# 同样走 overlay（upper = data/.system/www/server），重建后组件还在、不用重装；
# 面板代码 /www/server/panel 由 init.sh 用镜像绑定盖回，不落持久化层（换镜像即升级）。
PERSIST_SYSTEM_DIRS="${PERSIST_SYSTEM_DIRS:-etc usr var root opt home srv www/server}"

# 关键目录：持久化失败即静默丢数据，必须在容器状态里直接可见。
# init.sh 对失败的挂载逐个比对本列表，命中就写 /run/baota/critical，
# healthcheck 据此判 unhealthy。
# ★ 写容器内的挂载点路径（系统层传 /etc、/var…，bind 失败传 /www/xxx），
#   写成顶层名（如 www）永远对不上 —— www 不再整体挂载，只有子目录才持久化。
# /usr 必须在列表：用户 apt 装的软件 / PHP 扩展都落 /usr，持久化失败却状态仍绿
# =「绿着丢数据」，要等重建后才发现。面板状态子目录同理（data 丢=配置库没了；
# vhost 丢=站点证书与配置没了、HTTPS 起不来），都在 bind 层、失败即静默丢。
CRITICAL_DIRS="${CRITICAL_DIRS:-/etc /usr /var /www/server /www/wwwroot /www/server/data /www/server/panel/data /www/server/panel/vhost /www/server/panel/ssl /www/server/panel/config /www/server/panel/plugin}"

# 健康检查的磁盘水位阈值（/baota/healthcheck.sh 每 30 秒现查一次）。
#   任一持久化根「可用 < DISK_MIN_AVAIL_MB」或「已用 ≥ DISK_MAX_USED_PCT」
#   即判 unhealthy —— 满盘时 InnoDB 会写坏、面板配置会失败，必须在崩溃前暴露。
# 大盘（几 TB 存储池）上 1GB 的告警线偏低时可调大，例如 10240（10GB）
DISK_MIN_AVAIL_MB="${DISK_MIN_AVAIL_MB:-1024}"
DISK_MAX_USED_PCT="${DISK_MAX_USED_PCT:-95}"

# 升级 / 降级前自动快照的保留份数。0 表示关闭快照
AUTO_SNAPSHOT_KEEP="${AUTO_SNAPSHOT_KEEP:-3}"
